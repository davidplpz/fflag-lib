{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "domain/*": ["./src/domain/*"],
      "application/*": ["./src/application/*"],
      "infrastructure/*": ["./src/infrastructure/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}